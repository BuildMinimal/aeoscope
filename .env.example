# Postgres connection used by the app and drizzle-kit
DATABASE_URL=postgresql://aeoscope:aeoscope@localhost:5432/aeoscope

# AI provider keys (BYOK) - fill in the ones you use. The mock engine needs none.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# PERPLEXITY_MODEL=sonar
# GEMINI_MODEL=gemini-3.8-flash

# Google Search grounding for Gemini: live web answers + source citations
# (billed by Google beyond its free tier). Off by default.
# GEMINI_SEARCH=true
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Local models (optional) - pick ONE of the two options below ---

# Option 1 - Ollama: the Ollama engine works with no configuration when Ollama
# runs on its default port. Uncomment to override the defaults only.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Option 2 - any OpenAI-compatible server (LM Studio, llama.cpp, vLLM, Jan,
# LocalAI, ...). Setting CUSTOM_BASE_URL enables the "Custom" engine in
# Settings. It can also reach Ollama via its /v1 endpoint.
# LM Studio: CUSTOM_BASE_URL=http://localhost:1234/v1
# Ollama:    CUSTOM_BASE_URL=http://localhost:11434/v1
# (when aeoscope itself runs in docker, localhost inside the container is not
#  your machine - use http://host.docker.internal:1234/v1 instead)
# CUSTOM_BASE_URL=
# CUSTOM_MODEL=local-model
# CUSTOM_API_KEY=   (only if your server requires one)

# Protects POST /api/cron (for external schedulers). Leave empty to disable the endpoint.
CRON_SECRET=

# Set to "off" to disable the built-in cron scheduler
# AEOSCOPE_SCHEDULER=off
